# Copy to .env.local (git-ignored) and edit. Never commit real values.
# The app runs with NO credentials: every integration defaults to simulated (mock) mode.

# ---- Server ----
PORT=3000
DATABASE_PATH=./data/motivestack.db
# Set to false to run the worker as a separate process (npm run worker).
WORKER_IN_PROCESS=true

# ---- Meta / CRM mode (default: mock) ----
# "mock": Meta and GoHighLevel are simulated. "live": enables ONLY the providers you also switch on below.
INTEGRATION_MODE=mock
LIVE_META=false
# LIVE_GHL is not supported yet (the CRM connector is simulated only). Setting it to true fails at startup.
LIVE_GHL=false

# ---- Live Meta (only read when INTEGRATION_MODE=live and LIVE_META=true) ----
# Use a sandbox token first. Writes stay approval-gated and PAUSED-only.
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0
# Ad accounts where writes are allowed, e.g. the sandbox: act_2327392417830705. Empty = all writes refused.
META_WRITE_ALLOWLIST=
META_TIMEOUT_MS=30000
# Optional: lets the live read-only test also list campaigns on this account.
META_LIVE_TEST_ACCOUNT=

# ---- AI providers (default: mock) ----
# Exactly ONE kind of provider is eligible per mode; kinds are never mixed.
# "mock":  a deterministic offline model answers. No provider is contacted; API keys below are IGNORED.
# "local": a model server on THIS machine answers (Ollama). Real output, no key, no billing, nothing leaves the computer.
#          Needs Ollama running (npm run local:preflight). Slow on a CPU. Paid providers stay unavailable.
# "live":  paid OpenAI/Anthropic calls. This ALSO requires ALLOW_LIVE_PROVIDER_CALLS=true (a second, explicit switch);
#          live without it is a startup error. Live calls can be billed.
AI_PROVIDER_MODE=mock
ALLOW_LIVE_PROVIDER_CALLS=false

# Local mode only. Must be this machine (localhost, 127.0.0.1 or ::1); any other host stops the app at startup.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Server-side keys. Read ONLY when live AI is enabled. Never put these in the browser, chat, logs or git.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional base URLs (e.g. a proxy or a compatible gateway).
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=

# Model registry and price list (files, no secrets). Defaults shown.
# Model IDs and prices are configuration: edit config/ai-models.json and config/ai-pricing.json, not code. The shipped
# prices were read from the official pages on 2026-10-16 (docs/ai-verification.md). A model with no price has an
# UNKNOWN cost (never zero), and a cost-limited request for it is refused.
AI_MODELS_FILE=config/ai-models.json
AI_PRICING_FILE=config/ai-pricing.json

# Hard ceiling on output tokens for any single request (callers may ask for less, never more).
AI_MAX_OUTPUT_TOKENS=2000

# Gateway policy.
AI_MAX_RETRIES=2          # extra attempts after rate limit / timeout / provider outage (max 5)
AI_TIMEOUT_MS=60000       # per-attempt timeout
AI_REPAIR_ATTEMPTS=1      # 0 or 1 repair attempt after invalid structured output
# OPENAI_SERVICE_TIER=default   # optional: pin OpenAI's processing tier (default = standard pricing). Unset, the project's own setting decides, and a faster tier costs more. The evaluation command pins it for you.
# OPENAI_STORE=false            # optional: send store:false on OpenAI Responses requests (asks the API not to keep the response for later retrieval). Unset = the provider default. This is NOT a guarantee of zero retention in the provider's own logging or abuse monitoring. The evaluation command sets it for you.

# ---- Opt-in LOCAL measurement (free; npm run local:preflight, test:local:ollama) ----
# How many real briefs to generate, and the minimum first-try schema-valid rate the test requires.
LOCAL_SAMPLES=5
LOCAL_MIN_VALID_RATE=0.6

# ---- Opt-in live verification (npm run live:preflight, test:live:openai, test:live:anthropic) ----
# Defaults are the cheapest models verified against the providers' docs on 2026-10-16 (see docs/ai-verification.md).
OPENAI_LIVE_TEST_MODEL=gpt-6-luna
ANTHROPIC_LIVE_TEST_MODEL=claude-haiku-5-5
# Hard test budget in micro-USD (50000 = 0.05 USD) and per-request output cap.
LIVE_TEST_BUDGET_MICROS=50000
LIVE_TEST_MAX_OUTPUT_TOKENS=400
# File the live tests read keys from (default .env.local). Must be git-ignored.
LIVE_ENV_FILE=.env.local
