# Copy to .env.local (git-ignored) and edit. Never commit real values.
# The app runs with NO credentials: every integration defaults to simulated (mock) mode.

# ---- Server ----
PORT=3000
DATABASE_PATH=./data/motivestack.db
# Set to false to run the worker as a separate process (npm run worker).
WORKER_IN_PROCESS=true

# ---- Authentication (default: workspace tokens only) ----
# "workspace_token": the existing per-workspace bearer token is the only credential.
# "oidc": an OpenID Connect provider identifies people at /api/me. Workspace routes still use workspace tokens until Milestone 4.2.
# See docs/milestone-4-auth.md. These are public identifiers, not secrets; there is no client secret anywhere in this app.
AUTH_MODE=workspace_token
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URI=
# REQUIRED with AUTH_MODE=oidc, together with the four values above and OIDC_MAX_TOKEN_LIFETIME_SEC below. Nothing is defaulted.
# OIDC_CLIENT_ID is the browser client's id. It must differ from OIDC_AUDIENCE: an ID token is addressed to the client id, and a bearer
# that names the client id as an audience, or carries nonce / at_hash / c_hash, is refused as an ID token.
# OIDC_CLIENT_ID=
# Accepted values of the access token's "typ" header. Default: at+jwt (RFC 9068). A token with another or no typ is refused, so a provider
# that does not emit it fails closed until its real format is verified (docs/idp-compatibility.md, check S6). Name another value ONLY then.
# OIDC_ACCESS_TOKEN_TYPES=at+jwt
# OIDC_ALGORITHMS=RS256,ES256
# --- closed pilot (M4.4.1). With AUTH_MODE=oidc EVERYTHING below defaults to CLOSED. ---
# Who may be provisioned as a user and create workspaces: exact subjects ("sub" claim) of OIDC_ISSUER, comma separated. No emails, no
# wildcards. Empty = nobody can sign up. People you want to invite to a workspace must be listed too (they sign in once, then an owner adds them).
# OIDC_ALLOWED_SUBJECTS=
# Who may claim a legacy workspace with its token (migration only). Empty = claiming is disabled. Must be a subset of the list above.
# A claimer becomes OWNER, which includes managing stored credentials: list only people you would trust with that.
# OIDC_CLAIM_SUBJECTS=
# REQUIRED. The access-token lifetime you configured at the provider (target: 600), 60 to 900. exp - iat may not exceed it (no leeway on that
# duration); the remaining life against this server's clock may exceed it by the 60 s clock leeway. 900 is a hard ceiling.
# OIDC_MAX_TOKEN_LIFETIME_SEC=600
# Longest cached signing keys are trusted after the last SUCCESSFUL fetch, seconds. Past it, sign-in fails (503) until the provider answers. Default 86400. 600 to 604800.
# OIDC_JWKS_MAX_AGE_SEC=86400
# Require tokens to carry azp equal to OIDC_CLIENT_ID (some providers do not issue azp, so this is off by default). Tokens with several audiences always need it.
# OIDC_REQUIRE_AZP=false
# Workspace-claim attempts per person (only people on OIDC_CLAIM_SUBJECTS count). Defaults shown: 10 attempts per 3600 s.
# CLAIM_RL_MAX=10
# CLAIM_RL_WINDOW_SEC=3600

# ---- Browser and deployment boundary (M4.4c Package 2). See docs/browser-deployment-security.md. ----
# This server listens on 127.0.0.1 over plain HTTP. Host headers are accepted for localhost, 127.0.0.1 and [::1] only. To serve it under a public
# name, put a TLS-terminating proxy in front and list the exact public origin(s) here (comma separated, https only, no path or trailing slash).
# Forwarded-host and forwarded-protocol headers are NEVER trusted. Unset = loopback only.
# PUBLIC_ORIGINS=https://app.example.com
# Strict-Transport-Security max-age in seconds (0 = off, the default). Only sent for requests to an https PUBLIC_ORIGINS host; start small.
# HSTS_MAX_AGE_SEC=0
# General API volume per signed-in person (in-process, per server instance). Defaults shown: 1200 requests per 60 s.
# API_RL_MAX=1200
# API_RL_WINDOW_SEC=60

# ---- Encrypted credential vault (default: OFF) ----
# Master keys for per-workspace credential storage (Milestone 4.3; see docs/credential-security.md). Unset = the vault is off and
# nothing is stored. Each key is 32 random bytes, base64. These are SECRETS: inject them from your platform's secret store, never
# commit them. This keyring is for development and tests; real customer credentials need a managed key service (decision pending).
# A keyring here is IGNORED unless BOTH DEPLOYMENT_ENV is development or test AND CREDENTIAL_ALLOW_LOCAL_KEYRING=true. In production it is
# refused whatever else is set (credential storage then needs an approved managed key provider, which is not chosen yet: the vault stays OFF).
# DEPLOYMENT_ENV: development | test | production. Unset = not known to be development/test, so a local keyring is refused. Any other value stops startup.
# DEPLOYMENT_ENV=development
# CREDENTIAL_KEYRING=k1:<base64 of 32 random bytes>
# CREDENTIAL_ACTIVE_KEY=k1
# CREDENTIAL_ALLOW_LOCAL_KEYRING=true

# Rate limits for credential writes (in-process; per workspace and person). Defaults shown. See docs/credential-security.md section 4b.
# CREDENTIAL_RL_CALLER_MAX=10
# CREDENTIAL_RL_WORKSPACE_MAX=30
# CREDENTIAL_RL_WINDOW_SEC=60
# CREDENTIAL_RL_FAILURE_MAX=5
# CREDENTIAL_RL_FAILURE_WINDOW_SEC=300
# CREDENTIAL_RL_LOCKOUT_SEC=900
# CREDENTIAL_RL_DENIED_AUDIT_MAX=10

# ---- Meta / CRM mode (default: mock) ----
# "mock": Meta and GoHighLevel are simulated. "live": enables ONLY the providers you also switch on below.
INTEGRATION_MODE=mock
LIVE_META=false
# LIVE_GHL is not supported yet (the CRM connector is simulated only). Setting it to true fails at startup.
LIVE_GHL=false

# ---- Live Meta (only read when INTEGRATION_MODE=live and LIVE_META=true) ----
# Use a sandbox token first. Writes stay approval-gated and PAUSED-only.
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0
# Ad accounts where writes are allowed, e.g. the sandbox: act_2327392417830705. Empty = all writes refused.
META_WRITE_ALLOWLIST=
META_TIMEOUT_MS=30000
# Optional: lets the live read-only test also list campaigns on this account.
META_LIVE_TEST_ACCOUNT=

# ---- AI providers (default: mock) ----
# Exactly ONE kind of provider is eligible per mode; kinds are never mixed.
# "mock":  a deterministic offline model answers. No provider is contacted; API keys below are IGNORED.
# "local": a model server on THIS machine answers (Ollama). Real output, no key, no billing, nothing leaves the computer.
#          Needs Ollama running (npm run local:preflight). Slow on a CPU. Paid providers stay unavailable.
# "live":  paid OpenAI/Anthropic calls. This ALSO requires ALLOW_LIVE_PROVIDER_CALLS=true (a second, explicit switch);
#          live without it is a startup error. Live calls can be billed.
AI_PROVIDER_MODE=mock
ALLOW_LIVE_PROVIDER_CALLS=false

# Local mode only. Must be this machine (localhost, 127.0.0.1 or ::1); any other host stops the app at startup.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Server-side keys. Read ONLY when live AI is enabled. Never put these in the browser, chat, logs or git.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional base URLs (e.g. a proxy or a compatible gateway).
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=

# Model registry and price list (files, no secrets). Defaults shown.
# Model IDs and prices are configuration: edit config/ai-models.json and config/ai-pricing.json, not code. The shipped
# prices were read from the official pages on 2026-10-16 (docs/ai-verification.md). A model with no price has an
# UNKNOWN cost (never zero), and a cost-limited request for it is refused.
AI_MODELS_FILE=config/ai-models.json
AI_PRICING_FILE=config/ai-pricing.json

# Hard ceiling on output tokens for any single request (callers may ask for less, never more).
AI_MAX_OUTPUT_TOKENS=2000

# Gateway policy.
AI_MAX_RETRIES=2          # extra attempts after rate limit / timeout / provider outage (max 5)
AI_TIMEOUT_MS=60000       # per-attempt timeout
AI_REPAIR_ATTEMPTS=1      # 0 or 1 repair attempt after invalid structured output
# OPENAI_SERVICE_TIER=default   # optional: pin OpenAI's processing tier (default = standard pricing). Unset, the project's own setting decides, and a faster tier costs more. The evaluation command pins it for you.
# OPENAI_STORE=false            # optional: send store:false on OpenAI Responses requests (asks the API not to keep the response for later retrieval). Unset = the provider default. This is NOT a guarantee of zero retention in the provider's own logging or abuse monitoring. The evaluation command sets it for you.

# ---- Opt-in LOCAL measurement (free; npm run local:preflight, test:local:ollama) ----
# How many real briefs to generate, and the minimum first-try schema-valid rate the test requires.
LOCAL_SAMPLES=5
LOCAL_MIN_VALID_RATE=0.6

# ---- Opt-in live verification (npm run live:preflight, test:live:openai, test:live:anthropic) ----
# Defaults are the cheapest models verified against the providers' docs on 2026-10-16 (see docs/ai-verification.md).
OPENAI_LIVE_TEST_MODEL=gpt-6-luna
ANTHROPIC_LIVE_TEST_MODEL=claude-haiku-5-5
# Hard test budget in micro-USD (50000 = 0.05 USD) and per-request output cap.
LIVE_TEST_BUDGET_MICROS=50000
LIVE_TEST_MAX_OUTPUT_TOKENS=400
# File the live tests read keys from (default .env.local). Must be git-ignored.
LIVE_ENV_FILE=.env.local

# ---- Live AI spending ceiling (REQUIRED before any live request; mock mode ignores it) ----
# The server refuses every live (paid) AI request unless this is set. It is the most live requests may cost in one UTC month, all workspaces
# together, in micro-units of the price list's currency (50000 = 0.05 USD). Before each request the server reserves the worst case (full
# input, full output cap, every retry/repair attempt) and refuses if it would not fit. It is the application's own estimate from provider-reported
# token counts and config/ai-pricing.json; it is NOT your provider's billing limit, so also set a limit in the provider's dashboard.
# A model with no price, or an earlier live request with no token count, pauses live requests (cost cannot be verified).
# AI_LIVE_BUDGET_MICROS=50000
# Optional hard cap on live requests per UTC day, all workspaces.
# AI_LIVE_MAX_REQUESTS_PER_DAY=20

# ---- Website analysis (Business Brain) ----
# Pages read per site (1 to 10, default 8) and analyses per workspace per day (default 10). Only public http(s) sites on the standard ports are read.
# WEBSITE_MAX_PAGES=6
# WEBSITE_MAX_ANALYSES_PER_DAY=10
